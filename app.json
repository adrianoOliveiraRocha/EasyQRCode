{
  "expo": {
    "name": "Easy QRCode",
    "slug": "easy-qrcode",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#e3eaa7"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4b85c5"
      },
      "permissions" : ["CAMERA"],
      "package": "qrcode.easy.w3software",
      "versionCode": 5
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
